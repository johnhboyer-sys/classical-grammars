work/tables/adjudication.html
work/tables/adjudication-queue.html
work/tables/adjudication-structure.html
work/tables/adjudication-proposals.html
work/tables/adjudication-crops/
work/tables/tables.json
work/tables/review599.html
work/tables/review599-batch.html
work/tables/review599-tables.html
work/tables/review599-crops/
work/tables/laneB-raw/

